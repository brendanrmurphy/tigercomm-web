[
  {
    "label": "Testimonial source",
    "name": "source_mode",
    "type": "choice",
    "display": "radio",
    "help_text": "Choose whether testimonials come from a HubDB table or are entered directly in this module.",
    "choices": [
      ["hubdb", "Pull testimonials from HubDB"],
      ["manual", "Enter testimonials manually"]
    ],
    "default": "hubdb"
  },
  {
    "label": "Testimonials HubDB table",
    "name": "source_table",
    "type": "hubdbtable",
    "help_text": "Select the HubDB table with content, author, title, category, and disabled columns. Rows with disabled checked are hidden.",
    "required": false,
    "visibility": {
      "controlling_field": "source_mode",
      "controlling_value_regex": "hubdb",
      "operator": "EQUAL"
    }
  },
  {
    "label": "HubDB category query",
    "name": "hubdb_query",
    "type": "text",
    "help_text": "Filter the feed by the category option's internal value. Example: category__contains=homepage. You can also add sorting, such as &orderBy=hs_created_at. Leave blank to show all rows.",
    "default": "category__contains=homepage",
    "visibility": {
      "controlling_field": "source_mode",
      "controlling_value_regex": "hubdb",
      "operator": "EQUAL"
    }
  },
  {
    "label": "Section heading",
    "name": "section_heading",
    "type": "text",
    "required": true,
    "default": "What Our Clients Say"
  },
  {
    "label": "Testimonials heading",
    "name": "testimonials_heading",
    "type": "text",
    "required": true,
    "default": "Testimonials"
  },
  {
    "label": "Image",
    "name": "image",
    "type": "image",
    "responsive": true,
    "resizable": true,
    "show_loading": true,
    "default": {
      "loading": "lazy"
    }
  },
  {
    "label": "Testimonials",
    "name": "testimonials",
    "type": "group",
    "help_text": "Used when Testimonial source is set to Enter testimonials manually.",
    "visibility": {
      "controlling_field": "source_mode",
      "controlling_value_regex": "manual",
      "operator": "EQUAL"
    },
    "occurrence": {
      "default": 3,
      "min": 1,
      "max": null,
      "sorting_label_field": "testimonials.author"
    },
    "children": [
      {
        "label": "Quote",
        "name": "quote",
        "type": "text",
        "required": true,
        "default": "Add the client's testimonial."
      },
      {
        "label": "Author",
        "name": "author",
        "type": "text",
        "required": true,
        "default": "Client name"
      },
      {
        "label": "Title and company",
        "name": "author_title",
        "type": "text",
        "default": "Title, Company"
      }
    ],
    "default": [
      {
        "quote": "Add the client's testimonial.",
        "author": "Client name",
        "author_title": "Title, Company"
      }
    ]
  }
]
